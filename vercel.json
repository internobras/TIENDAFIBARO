{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source":"/area-cliente","destination":"https://fibaro-panel-v1.vercel.app/login","permanent":false}
  ],
  "rewrites": [
    {"source":"/telecom","destination":"/"},
    {"source":"/energia","destination":"/"},
    {"source":"/empresas","destination":"/"},
    {"source":"/zona-fibaro","destination":"/"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; connect-src 'self' https://kgcuqxzpxykqszdeonte.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]},
    {"source":"/config.js","headers":[{"key":"Cache-Control","value":"public, max-age=60, s-maxage=60, stale-while-revalidate=300"}]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"}]}
  ]
}
