{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/telecom","destination":"/index.html"},
    {"source":"/energia","destination":"/index.html"},
    {"source":"/empresas","destination":"/index.html"},
    {"source":"/zona-fibaro","destination":"/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"X-Frame-Options","value":"DENY"}
    ]}
  ]
}
