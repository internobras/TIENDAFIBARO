{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"X-Frame-Options","value":"DENY"}
    ]}
  ],
  "rewrites": [
    {"source":"/telecom","destination":"/index.html"},
    {"source":"/energia","destination":"/index.html"},
    {"source":"/empresas","destination":"/index.html"},
    {"source":"/zona-fibaro","destination":"/index.html"},
    {"source":"/c/:path*","destination":"/index.html"},
    {"source":"/privacidad","destination":"/privacidad.html"},
    {"source":"/aviso-legal","destination":"/aviso-legal.html"},
    {"source":"/admin","destination":"/admin/index.html"}
  ]
}